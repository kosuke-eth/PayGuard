# PayGuard local development environment template.
# Copy to .env and fill in values marked VALUE_REQUIRED_FROM_USER (see docs/ENV_SETUP.md).
# Never commit a filled .env (see .gitignore: .env / .env.* are ignored, this file is not).
#
# GENERATED BY DEPLOYMENT = value comes from `./scripts/payguard demo:setup` (or demo:reset)
#   output, not something you invent.
# SECRET = private key or credential material. Every SECRET below is a disposable Anvil
#   dev-account key, well-known and public, never a real credential -- see the comment on
#   each one. API and worker processes must NEVER hold a real human owner's private key
#   (CLAUDE.md invariant); `assertNoOwnerKeyConfigured` in both apps/api/src/config.ts and
#   apps/worker/src/config.ts refuses to boot if OWNER_PRIVATE_KEY/VAULT_OWNER_PRIVATE_KEY/
#   OWNER_KEY/OWNER_MNEMONIC are set at all.
# LOCAL-ONLY = fine as-is for local dev; must be reconsidered before any non-local deployment.

# --- Runtime ---
PAYGUARD_ENVIRONMENT=LOCAL_DEMO
# API_HOST=127.0.0.1
API_PORT=3000
# API_TLS_ENABLED=false

# --- Database ---
DATABASE_URL=postgresql://payguard:payguard_local_dev@127.0.0.1:5432/payguard_dev
# Used only by packages/db/test and apps/{api,worker}/test's shared test-database helpers.
DATABASE_TEST_URL=postgresql://payguard:payguard_local_dev@127.0.0.1:5432/payguard_test

# --- Chain / RPC ---
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545

# --- PayGuard deployment ---
# GENERATED BY DEPLOYMENT. Printed by `./scripts/payguard demo:setup` after it provisions (or
# reuses) a deployment. SPEC-018: the single deployment this API/worker process serves.
PAYGUARD_DEPLOYMENT_ID=VALUE_REQUIRED_FROM_USER

# --- API / browser auth ---
# API_SIWE_DOMAIN=127.0.0.1:3000                       # default: API_HOST:API_PORT
# API_SIWE_URI=http://127.0.0.1:3000                    # default: scheme://API_SIWE_DOMAIN
# API_ALLOWED_ORIGINS=http://127.0.0.1:3000              # comma-separated; default: scheme://API_SIWE_DOMAIN
# API_COOKIE_NAME=payguard_session
# API_COOKIE_SECURE=true                                 # LOCAL-ONLY: stays true even over http://127.0.0.1 (a
#   W3C "potentially trustworthy origin" -- see apps/api/src/config.ts's CookieConfig doc)
# API_COOKIE_SAMESITE=Strict
# API_SESSION_TTL_SECONDS=3600
# API_CHALLENGE_TTL_SECONDS=300
# API_WORKER_HEARTBEAT_STALENESS_SECONDS=30
# RELAYER_ADDRESS=                                       # optional label only, used as `from` in eth_call
#   simulations; set to the address matching RELAYER_PRIVATE_KEY below if you want simulations
#   to reflect the real relayer's balance/allowance.

# --- Worker / relayer ---
# SECRET, LOCAL-ONLY: Anvil well-known dev account #9's private key. Disposable, public
# knowledge, never used on any real network. The worker signs/pays for its own outer
# transaction with this key -- it is never the owner's key (CLAUDE.md: owner/agent/merchant/
# relayer are distinct roles).
RELAYER_PRIVATE_KEY=0x2a871d0798f97d79848a013d4936a73bf4cc922c825d33c1cf7073dff6d409c6
# WORKER_ID=                                             # default: a fresh random UUID per process start;
#   set explicitly only if you need a stable outbox lease-owner identity across restarts
# WORKER_LEASE_SECONDS=60
# WORKER_POLL_INTERVAL_MS=500
# WORKER_HEARTBEAT_INTERVAL_MS=5000
# WORKER_RECEIPT_POLL_ATTEMPTS=10
# WORKER_RECEIPT_POLL_INTERVAL_MS=250
# WORKER_INDEXER_BATCH_BLOCKS=500

# --- Demo actors (B2 demo bridge, API only; set PAYGUARD_DEMO_ENABLED=true to require the three
#     keys below -- omit/false to run without the demo bridge) ---
PAYGUARD_DEMO_ENABLED=true
# LOCAL-ONLY: label distinguishing which demo deployment `demo:setup`/`demo:reset` provision
# under; idempotency key for reuse-vs-provision-fresh.
PAYGUARD_DEMO_INSTANCE_LABEL=payguard-local-demo
# SECRET, LOCAL-ONLY: Anvil well-known dev account #1. Signs demo intents; never the owner key.
DEMO_AGENT_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
# SECRET, LOCAL-ONLY: Anvil well-known dev account #2. Signs demo invoices for enrolled profiles.
DEMO_MERCHANT_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a
# SECRET, LOCAL-ONLY: Anvil well-known dev account #9 (same as RELAYER_PRIVATE_KEY), reused
# deliberately as a merchant identity NEVER enrolled as an invoiceSigner on any demo policy --
# the "unauthorized merchant" scenario needs a real signature that the vault genuinely rejects.
DEMO_UNAUTHORIZED_MERCHANT_PRIVATE_KEY=0x2a871d0798f97d79848a013d4936a73bf4cc922c825d33c1cf7073dff6d409c6
# Destructive-action confirmation for demo-reset.ts only; leave unset. Set to the literal value
# `yes` only when you explicitly intend to deploy a brand-new demo vault and invalidate every
# EIP-712 signature under the old one.
# PAYGUARD_DEMO_RESET_CONFIRM=yes

# --- Uniswap v4 ---
# No separate v4 env vars: the v4 pool/adapter/vault identities are provisioned by
# `demo:setup`/`demo:reset` (packages/test-utils/src/v4VaultFixture.ts) and stored in
# PostgreSQL's `deployments`/`vaults`/`policies` rows, not read from the environment. See
# docs/implementation/B2_BACKEND_HANDOFF.md.

# --- Aqua / SwapVM ---
# Same as above: Aqua/router/strategy identities live in the deployment's DB rows, not in env
# vars. See packages/test-utils/src/aquaVaultFixture.ts and docs/implementation/B2_BACKEND_HANDOFF.md.

# --- Optional features ---
# Fee subsidy is NOT_SELECTED for the required MVP gates (CLAUDE.md) -- there is no env var for
# it because no code path reads one; normal swap fees always apply.
