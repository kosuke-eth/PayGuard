# PayGuard local development environment template.
# Copy to .env and fill placeholders. Never commit a filled .env (see .gitignore).
#
# Every value in this file is a LOCAL DEVELOPMENT placeholder. None of these
# variables may ever hold a real human owner's private key — API and worker
# processes must never require owner authority (CLAUDE.md invariant).

# --- Deployment / chain ---
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
ENVIRONMENT=LOCAL_DEMO

# --- Relayer (worker only; a dedicated local EOA, gas funds only, no owner/admin authority) ---
# Local dev default: Anvil's well-known account #9 private key. Disposable, public knowledge,
# never used on any real network. Replace only with another equally disposable local dev key.
RELAYER_PRIVATE_KEY=0x2a871d0798f97d79848a013d4936a73bf4cc922c825d33c1cf7073dff6d409c6

# --- PostgreSQL ---
DATABASE_URL=postgresql://payguard:payguard_local_dev@127.0.0.1:5432/payguard_dev

# --- API ---
API_PORT=3000
SESSION_COOKIE_SECRET=replace_with_local_random_value
# Local-only HTTPS/origin accommodation for SIWE cookie testing; must never reach
# the testnet configuration (CLAUDE.md / API_CONTRACT.md common wire rules).
API_LOCAL_ORIGIN=http://127.0.0.1:3000
