{
  "name": "@payguard/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PayGuard owner control panel (React + Vite). A client of the real /v1 API: it displays and initiates, it never decides payment truth.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node server.mjs",
    "preview": "pnpm build && node server.mjs",
    "mock-api": "node dev/mock-api.mjs"
  },
  "dependencies": {
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource/spline-sans-mono": "^5.3.0",
    "@payguard/integration": "workspace:*",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "viem": "2.56.3"
  },
  "devDependencies": {
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "typescript": "5.9.3",
    "vite": "7.1.5"
  }
}
