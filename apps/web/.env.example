# Browser-safe / dev-server values only. Nothing here is a secret and nothing here is bundled
# into the client: deployment data comes from GET /v1/config at runtime.

# Where the PayGuard Fastify API listens (apps/api). Used by the Vite dev proxy and server.mjs.
PAYGUARD_API_URL=http://127.0.0.1:3000

# Port this frontend is served on. The backend's API_SIWE_DOMAIN / API_SIWE_URI /
# API_ALLOWED_ORIGINS must name this exact origin (http://localhost:5173 by default).
WEB_PORT=5173
